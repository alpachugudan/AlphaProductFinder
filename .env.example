APP_ENV=development
APP_NAME=miraeasset-product-finder
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/product_finder
SOURCE_DATA_DIR=../데이터셋
LLM_PROVIDER=mock
# HCX real calls: keep secrets only in .env, never in Git or logs.
HCX_API_KEY=
HCX_BASE_URL=https://clovastudio.stream.ntruss.com
HCX_INTENT_MODEL=HCX-007
HCX_ANSWER_MODEL=HCX-007
HCX_CONNECT_TIMEOUT_SECONDS=5
HCX_READ_TIMEOUT_SECONDS=20
HCX_MAX_RETRIES=1
HCX_PROMPT_VERSION=hcx-v1
# HCX is token-billed. In credit_only mode every actual call is blocked until the
# operator has confirmed the active NCP credit balance and expiry in the console.
BILLING_MODE=credit_only
CREDIT_BALANCE_CONFIRMED=false
NCP_EMBEDDING_ENABLED=false
NCP_EMBEDDING_MODEL=bge-m3
INTERNAL_TIMEOUT_SECONDS=120
MAX_QUESTION_LENGTH=4000
CACHE_CAPACITY=128
READINESS_CACHE_SECONDS=30
DEFAULT_RESULT_LIMIT=5
MAX_RESULT_LIMIT=10
